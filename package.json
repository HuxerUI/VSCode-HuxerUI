{
  "name": "huxerui",
  "displayName": "HuxerUI",
  "description": "Create, build, and run HuxerUI projects in Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "huxerui",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Programming Languages", "Other", "Extension Packs"],
  "main": "./out/extension.js",
  "files": [
    "out/**/*.js",
    "media/*",
    "docs/design.md",
    "LICENSE",
    "README.md"
  ],
  "extensionPack": [
    "ms-vscode.cpptools",
    "ms-vscode.cmake-tools"
  ],
  "extensionKind": ["workspace"],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:huxerui",
    "workspaceContains:HuxerUIProject.cmake",
    "workspaceContains:mcpp.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "HuxerUI only runs tools in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "huxerui", "title": "HuxerUI", "icon": "media/huxerui.svg" }
      ]
    },
    "views": {
      "huxerui": [
        { "id": "huxerui.projects", "name": "HuxerUI", "type": "webview", "icon": "media/huxerui.svg", "when": "workspaceFolderCount == 0 || huxerui.hasProject" }
      ]
    },
    "commands": [
      { "command": "huxerui.create", "title": "HuxerUI: Create Project" },
      { "command": "huxerui.selectSdk", "title": "HuxerUI: Select SDK" },
      { "command": "huxerui.rebuildSourceCli", "title": "HuxerUI: Rebuild Source CLI" },
      { "command": "huxerui.doctor", "title": "HuxerUI: Diagnose Environment" },
      { "command": "huxerui.setup", "title": "HuxerUI: Set Up Toolchain" },
      { "command": "huxerui.build", "title": "HuxerUI: Build" },
      { "command": "huxerui.run", "title": "HuxerUI: Run" },
      { "command": "huxerui.debug", "title": "HuxerUI: Debug" },
      { "command": "huxerui.watch", "title": "HuxerUI: Run with Watch" },
      { "command": "huxerui.stop", "title": "HuxerUI: Stop" },
      { "command": "huxerui.package", "title": "HuxerUI: Package" },
      { "command": "huxerui.openArtifacts", "title": "HuxerUI: Open Artifacts" }
    ],
    "configuration": {
      "title": "HuxerUI",
      "properties": {
        "huxerui.sdkVersion": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Exact released SDK version for this project's CMake operations. Leave empty to use the project's selected SDK."
        },
        "huxerui.sdkPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "machine",
          "description": "Additional installed SDK roots on the execution host."
        },
        "huxerui.sourceCheckout": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Preferred HuxerUI source checkout on the execution host. The extension can find or build its CLI."
        },
        "huxerui.sourceCli": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to a CLI built outside the configured HuxerUI checkout."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "huxerui",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["doctor", "build", "run", "watch", "package"],
            "description": "Operation to run."
          },
          "project": {
            "type": "string",
            "description": "Project directory relative to this workspace folder."
          },
          "buildSystem": {
            "type": "string",
            "enum": ["cmake", "mcpp"],
            "description": "Build system for a directory containing both types of project."
          },
          "target": {
            "type": "string",
            "enum": ["windows", "macos", "linux", "android", "ios", "web"],
            "description": "CMake target. Defaults to the execution host when possible."
          },
          "configuration": {
            "type": "string",
            "enum": ["debug", "release"],
            "description": "Build configuration. Package defaults to release."
          },
          "device": {
            "type": "string",
            "description": "Optional Android or iOS destination ID."
          },
          "optimization": {
            "type": "string",
            "enum": ["default", "size", "minsize"],
            "description": "Optional CMake build size optimization."
          },
          "lto": {
            "type": "string",
            "enum": ["on", "off"],
            "description": "Optional CMake link-time optimization override."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package:vsix": "npm exec --yes --package=@vscode/vsce@4.1.1 -- vsce package --allow-missing-repository --no-rewrite-relative-links",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "typescript": "^5.9.3"
  }
}
